# Copy to backend/.env (or backend/.env.local) and fill in. Never commit these files.
ENVIRONMENT=development

# Hosted Postgres (Neon / Supabase). postgres:// URLs are accepted and converted to psycopg.
# Supabase: Project Settings -> Database -> Connection string -> URI, "Session pooler" (IPv4).
# Example: postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# NOT the https://PROJECTREF.supabase.co project URL.
DATABASE_URL=

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# If empty in development, an ephemeral secret is used (sessions reset on restart).
JWT_SECRET=
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:3000"]

# Google Sign-In via Firebase Auth: Firebase console -> Project settings -> Project ID
FIREBASE_PROJECT_ID=

# AI Tutor + RAG (Gemini). Get a key at https://aistudio.google.com/apikey. Server-side only, never sent to clients.
# Without a key the tutor shows "not configured" and /api/ai/* returns 503 ai_not_configured.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Tried in order when the main model is overloaded (429/503) or retired (404). Model list: https://ai.google.dev/gemini-api/docs/models
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Per-user limits
AI_MESSAGES_PER_MINUTE=12
AI_MESSAGES_PER_DAY=200

# Google Workspace (Phase 3): Drive/Docs + Calendar for students. Server-side OAuth web client.
# Google Cloud console (same project as Firebase) -> APIs & Services:
#   1. Enable "Google Drive API" and "Google Calendar API".
#   2. OAuth consent screen: add scopes drive.file and calendar.events; add test users while in Testing mode.
#   3. Credentials -> Create OAuth client ID -> Web application.
#      Authorized redirect URI must equal GOOGLE_OAUTH_REDIRECT_URI exactly (same host the students use).
# Without these, the UI shows "not available" and /api/google/* returns 503 google_not_configured.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/google/callback
# Encrypts stored Google tokens. Generate once and keep it (changing it forces everyone to reconnect):
#   .venv/Scripts/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_KEY=
# Encrypts MindCare journal notes and support requests at rest. Required in production.
# Generate once with the same command as above and keep a backup: losing or changing it makes stored notes unreadable.
DATA_ENCRYPTION_KEY=
# Where the API sends the browser back to after Google consent
WEB_APP_URL=http://localhost:3000
