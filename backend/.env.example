# Copy to backend/.env (or backend/.env.local) and fill in. Never commit these files.
ENVIRONMENT=development

# Hosted Postgres (Neon / Supabase). postgres:// URLs are accepted and converted to psycopg.
# Supabase: Project Settings -> Database -> Connection string -> URI, "Session pooler" (IPv4).
# Example: postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# NOT the https://PROJECTREF.supabase.co project URL.
DATABASE_URL=

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# If empty in development, an ephemeral secret is used (sessions reset on restart).
JWT_SECRET=
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:3000"]

# Google Sign-In via Firebase Auth: Firebase console -> Project settings -> Project ID
FIREBASE_PROJECT_ID=

# AI Tutor + RAG (Gemini). Get a key at https://aistudio.google.com/apikey. Server-side only, never sent to clients.
# Without a key the tutor shows "not configured" and /api/ai/* returns 503 ai_not_configured.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Per-user limits
AI_MESSAGES_PER_MINUTE=12
AI_MESSAGES_PER_DAY=200
