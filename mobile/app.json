{
  "expo": {
    "name": "IccheGhuri",
    "slug": "iccheghuri",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "iccheghuri",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F5F5F4",
    "android": {
      "package": "com.iccheghuri.study.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#F97316",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF7ED",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#121212",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Figtree",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Figtree_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Figtree_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Figtree_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/Figtree_700Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/Figtree_400Regular.ttf",
              "./assets/fonts/Figtree_500Medium.ttf",
              "./assets/fonts/Figtree_600SemiBold.ttf",
              "./assets/fonts/Figtree_700Bold.ttf"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
